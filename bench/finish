#!/usr/bin/env python3
"""Mark a run's start, or snapshot its deliverables at the deadline into submissions/ and commit (PROTOCOL.md §4–§6)."""

from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
# PROTOCOL.md §7: reference designs for these boards live in the kicad-tools repo.
LEAK_PATTERNS = (
    re.compile(r"github\.com/rjwalters/kicad-tools/(?:tree|blob|raw)/[^\s\"']*boards/", re.I),
    re.compile(r"raw\.githubusercontent\.com/rjwalters/kicad-tools/[^\s\"']*boards/", re.I),
    re.compile(r"codeload\.github\.com/rjwalters/kicad-tools", re.I),
    re.compile(r"git clone[^\n\"']*rjwalters/kicad-tools", re.I),
    # A local checkout on the same host (agents in native harnesses run on the host).
    re.compile(r"kicad-tools/boards/\d\d-", re.I),
)


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("run_id")
    ap.add_argument("--runs-dir", type=Path, default=Path.home() / "pcba-bench-runs")
    ap.add_argument("--mark-start", action="store_true", help="record the moment the initial prompt is sent")
    ap.add_argument("--transcript", type=Path, help="full agent session log")
    ap.add_argument("--continues", type=int, help="number of continue prompts sent")
    ap.add_argument("--tokens", type=int, help="total tokens, if known")
    ap.add_argument("--cost-usd", type=float, help="total cost, if known")
    ap.add_argument("--image-digest", help="track container image ID/digest")
    ap.add_argument("--no-commit", action="store_true", help="don't commit the submission to the branch")
    args = ap.parse_args()

    ws = args.runs_dir.expanduser().resolve() / args.run_id
    run_path = ws / ".run.json"
    if not run_path.is_file():
        sys.exit(f"no run at {ws}")
    run = json.loads(run_path.read_text())

    if args.mark_start:
        if run["started_at"]:
            sys.exit(f"already started at {run['started_at']}")
        run["started_at"] = now()
        run_path.write_text(json.dumps(run, indent=2) + "\n")
        deadline = datetime.fromisoformat(run["started_at"]) + timedelta(minutes=run["minutes"])
        print(f"started {run['started_at']}; deadline {deadline.isoformat(timespec='seconds')}")
        return 0

    if not run["started_at"]:
        sys.exit("run was never started (--mark-start)")
    if args.transcript is None or not args.transcript.is_file():
        sys.exit("--transcript is required (PROTOCOL.md §6)")

    run["finished_at"] = now()
    started = datetime.fromisoformat(run["started_at"])
    elapsed = (datetime.fromisoformat(run["finished_at"]) - started).total_seconds() / 60
    run["elapsed_minutes"] = round(elapsed, 1)
    run["over_deadline"] = elapsed > run["minutes"] + 1
    run["continue_prompts_sent"] = args.continues
    run["tokens"] = args.tokens
    run["cost_usd"] = args.cost_usd
    run["image_digest"] = args.image_digest

    text = args.transcript.read_text(errors="replace")
    hits = sorted({m.group(0)[:160] for pat in LEAK_PATTERNS for m in pat.finditer(text)})
    # A bare-track run must not use the kicad-tools CLI or MCP server, which may be
    # installed on the same host for other tracks and for judges.
    if run.get("track") == "bare":
        tool_use = sorted({m.group(0)[:80] for m in re.finditer(
            r"(?<![\w/-])kct\s+[a-z][\w-]*|mcp__kct__\w+|kicad_tools\.\w+", text)})
        if tool_use:
            hits += [f"bare track used kicad-tools: {t}" for t in tool_use[:20]]
    run["leak_scan"] = {"hits": hits, "clean": not hits}

    out = REPO / "submissions" / args.run_id
    if out.exists():
        sys.exit(f"{out} already exists")
    shutil.copytree(ws / "deliverables", out / "deliverables")
    # A board counts as attempted once its folder holds a KiCad schematic or PCB.
    run["attempted"] = sorted(b for b in run["boards"]
                              if any((out / "deliverables" / b).glob("*.kicad_sch"))
                              or any((out / "deliverables" / b).glob("*.kicad_pcb")))
    shutil.copy2(ws / ".tools.md", out / "tools.md")
    shutil.copy2(args.transcript, out / f"transcript{args.transcript.suffix}")
    (out / "run.json").write_text(json.dumps(run, indent=2) + "\n")

    print(f"submission: {out}")
    if not args.no_commit:
        branch = subprocess.run(["git", "-C", str(REPO), "rev-parse", "--abbrev-ref", "HEAD"],
                                capture_output=True, text=True).stdout.strip()
        if branch == "main":
            print("WARNING: on main; not committing. Switch to the run/<run-id> branch and commit there.")
        else:
            # Neutral message, no trailers: the commit must not identify the agent (blinding).
            subprocess.run(["git", "-C", str(REPO), "add", "--", str(out.relative_to(REPO))], check=True)
            subprocess.run(["git", "-C", str(REPO), "commit", "-q", "-m", f"Submission {args.run_id}"], check=True)
            print(f"committed on {branch}; now open this branch in each judge's harness (JUDGING.md)")
    if hits:
        print("WARNING: transcript scan found possible protocol violations (PROTOCOL.md §7):")
        for h in hits:
            print(f"  {h}")
    if run["over_deadline"]:
        print(f"WARNING: snapshot taken {elapsed:.0f} min after start (allotment {run['minutes']})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
