#!/usr/bin/env python3
"""Create the submission branch and an isolated suite workspace for one run (PROTOCOL.md §2, §5).

    bench/start --track kicad-tools --agent "claude-code 2.x / claude-opus-5-5" \\
                --tools prompts/tools/kicad-tools.md [--minutes 60]

The workspace (outside the checkout) holds every board's input set under boards/<id>/
and an empty deliverables/<id>/ for each. PROMPT.md is the initial prompt plus the
tools supplement. A run's id is opaque (run--<hex>); agent and toolkit live only in run.json.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import secrets
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
INPUT_FILES = ("BRIEF.md", "requirements.toml", "board.toml")
MARKER = "---- TOOLS SUPPLEMENT"
PROMPT_VERSION = 3
DEFAULT_MINUTES = 60


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def strip_comment(text: str) -> str:
    return re.sub(r"<!--.*?-->\s*", "", text, count=1, flags=re.S)


def all_boards() -> list[str]:
    return sorted(p.name for p in (REPO / "boards").iterdir() if (p / "board.toml").is_file())


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--track", required=True, help="toolkit label, e.g. bare, kicad-tools")
    ap.add_argument("--agent", required=True, help='agent + model, e.g. "claude-code 2.x / claude-opus-5-5"')
    ap.add_argument("--tools", required=True, type=Path, help="tools supplement markdown")
    ap.add_argument("--minutes", type=int, default=DEFAULT_MINUTES, help="total time for the whole suite")
    ap.add_argument("--boards", nargs="+", help="development only: a subset (missing boards still score 0)")
    ap.add_argument("--runs-dir", type=Path, default=Path.home() / "pcba-bench-runs")
    ap.add_argument("--no-branch", action="store_true", help="don't create the submission branch")
    args = ap.parse_args()

    boards = args.boards or all_boards()
    unknown = sorted(set(boards) - set(all_boards()))
    if unknown:
        sys.exit(f"unknown boards: {unknown}")
    tools = args.tools.resolve()
    if not tools.is_file():
        sys.exit(f"tools supplement not found: {tools}")
    runs_dir = args.runs_dir.expanduser().resolve()
    if runs_dir.is_relative_to(REPO):
        sys.exit("--runs-dir must be outside the pcba-bench checkout (PROTOCOL.md §2)")

    run_id = f"run--{secrets.token_hex(4)}"
    if not args.no_branch:
        dirty = subprocess.run(["git", "-C", str(REPO), "status", "--porcelain"], capture_output=True, text=True).stdout
        if dirty.strip():
            sys.exit("working tree is not clean; commit or stash first (or pass --no-branch)")
        subprocess.run(["git", "-C", str(REPO), "switch", "-q", "-c", f"run/{run_id}"], check=True)

    ws = runs_dir / run_id
    for b in boards:
        (ws / "boards" / b).mkdir(parents=True)
        for name in INPUT_FILES:
            shutil.copy2(REPO / "boards" / b / name, ws / "boards" / b / name)
        (ws / "deliverables" / b).mkdir(parents=True)

    initial = strip_comment((REPO / "prompts/initial.md").read_text())
    board_list = "\n".join(f"- `{b}`" for b in boards)
    initial = (initial.replace("{RUN_ID}", run_id).replace("{MINUTES}", str(args.minutes))
               .replace("{BOARD_COUNT}", str(len(boards))).replace("{BOARD_LIST}", board_list))
    head, _, _ = initial.partition(MARKER)
    prompt = head.rstrip() + "\n\n" + strip_comment(tools.read_text()).strip() + "\n"
    (ws / "PROMPT.md").write_text(prompt)
    shutil.copy2(tools, ws / ".tools.md")

    run = {
        "schema": 2,
        "run_id": run_id,
        "boards": boards,
        "track": args.track,
        "agent": args.agent,
        "minutes": args.minutes,
        "prompt_version": PROMPT_VERSION,
        "initial_prompt_sha256": hashlib.sha256(prompt.encode()).hexdigest(),
        "continue_prompt_sha256": sha256(REPO / "prompts/continue.md"),
        "tools_sha256": sha256(tools),
        "inputs_sha256": {b: {n: sha256(REPO / "boards" / b / n) for n in INPUT_FILES} for b in boards},
        "started_at": None,
        "finished_at": None,
        "continue_prompts_sent": None,
    }
    (ws / ".run.json").write_text(json.dumps(run, indent=2) + "\n")

    if not args.no_branch:
        # Record the run's condition on its branch (neutral message: blinding).
        rec = REPO / "submissions" / run_id
        rec.mkdir(parents=True)
        (rec / "run.json").write_text(json.dumps(run, indent=2) + "\n")
        subprocess.run(["git", "-C", str(REPO), "add", "--", str(rec.relative_to(REPO))], check=True)
        subprocess.run(["git", "-C", str(REPO), "commit", "-q", "-m", f"Start {run_id}"], check=True)

    if not args.no_branch:
        print(f"branch:    run/{run_id}")
    print(f"workspace: {ws}")
    print(f"prompt:    {ws / 'PROMPT.md'}")
    print("Launch the agent's harness with the workspace as cwd, send PROMPT.md, and start the clock:")
    print(f"  bench/finish {run_id} --mark-start")
    return 0


if __name__ == "__main__":
    sys.exit(main())
