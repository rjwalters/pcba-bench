#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["anthropic>=1.0", "openai>=1.0"]
# ///
"""Score one evidence-packed submission with the judge panel (RUBRIC.md, JUDGING.md).

    judging/score judging/out/<run-id>                    # aggregate native-harness judgements
                                                          #   from judging/responses/<run-id>/
    judging/score judging/out/<run-id> --responses DIR    # ... from another directory
    judging/score judging/out/<run-id> --api [--dry-run]  # API mode: call the three judges directly

Native-harness judging is the default: judging/start-judging builds each judge's
workspace and judging/finish-judging collects <vendor>.json. API mode sends the
same material in one request per judge and exists for automation and testing.

Writes judging/out/<run-id>.scores.json, which sits next to the judge bundle and
outside it. It holds:
  - every judge's raw output;
  - the caps the evidence imposed, and every clamp applied to a judge's score;
  - per-criterion medians, the 0-100 total, the Manufacturable flag;
  - disagreement flags (any criterion with a judge spread >= 2).
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import re
import statistics
import sys
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
sys.path.insert(0, str(HERE))
import judgement  # noqa: E402

JUDGING_VERSION = 1
CRITERIA = ("A", "B", "C", "D", "E", "F")
WEIGHTS = {"A": 25, "B": 25, "C": 20, "D": 15, "E": 10, "F": 5}
VERDICT_VALUE = {"met": 1.0, "partial": 0.5, "unmet": 0.0}
MAX_DESIGN_FILE_BYTES = 400_000
EVIDENCE_LIST_LIMIT = 60


# ------------------------------------------------------------------ prompt

def strip_comment(text: str) -> str:
    return re.sub(r"<!--.*?-->\s*", "", text, count=1, flags=re.S)


def load(path: Path) -> dict:
    return json.loads(path.read_text()) if path.is_file() else {}


def condensed_kicad_report(report: dict) -> dict:
    """KiCad ERC/DRC reports can hold thousands of items: keep counts by type plus a capped sample."""
    out = {}
    for key in ("violations", "unconnected_items", "schematic_parity"):
        items = report.get(key)
        if items is None and key == "violations" and "sheets" in report:
            items = [v for s in report["sheets"] for v in s.get("violations", [])]
        if items is None:
            continue
        counts: dict[str, int] = {}
        for v in items:
            label = f"{v.get('severity')}:{v.get('type')}"
            counts[label] = counts.get(label, 0) + 1
        out[key] = {"total": len(items), "by_severity_type": counts,
                    "sample": [{k: v.get(k) for k in ("severity", "type", "description")}
                               for v in items[:EVIDENCE_LIST_LIMIT]],
                    "sample_note": f"first {min(len(items), EVIDENCE_LIST_LIMIT)} of {len(items)} items"}
    return out


def build_prompt(bundle: Path, with_images: bool) -> tuple[str, list[dict], list[str]]:
    """Return (system text, user content blocks, omissions disclosed to the judge)."""
    system = strip_comment((HERE / "judge-prompt.md").read_text()) + "\n\n" + (REPO / "RUBRIC.md").read_text()
    omissions: list[str] = []
    parts = []

    def section(title: str, body: str) -> None:
        parts.append(f"===== {title} =====\n{body.rstrip()}\n")

    for name in ("BRIEF.md", "requirements.toml", "board.toml"):
        section(f"inputs/{name}", (bundle / "inputs" / name).read_text())

    ev = bundle / "evidence"
    for name in ("summary.json", "stats.json", "lvs.json", "bom_resolution.json", "cpl.json",
                 "fab.json", "fab_rules_applied.json"):
        if (ev / name).is_file():
            section(f"evidence/{name}", (ev / name).read_text())
    for name in ("erc.json", "drc_fab.json", "drc.json"):
        if (ev / name).is_file():
            section(f"evidence/{name} (condensed)", json.dumps(condensed_kicad_report(load(ev / name)), indent=1))

    deliv = bundle / "deliverable"
    for rel in ("board.kicad_sch", "board.kicad_pcb", "fab/bom.csv", "fab/cpl.csv", "DECISIONS.md"):
        path = deliv / rel
        if not path.is_file():
            continue
        size = path.stat().st_size
        if size > MAX_DESIGN_FILE_BYTES:
            omissions.append(f"deliverable/{rel} omitted ({size} bytes); use stats.json, lvs.json and the renders")
            continue
        section(f"deliverable/{rel}", path.read_text(errors="replace"))

    images = sorted((bundle / "renders").glob("*.png")) if with_images else []
    if not with_images:
        omissions.append("renders not attached for this judge (text-only endpoint)")
    if omissions:
        section("NOTE: omitted from this bundle", "\n".join(f"- {o}" for o in omissions))
    section("TASK", "Score this submission now. Return only the JSON object.")

    blocks = [{"kind": "image", "name": p.name, "b64": base64.standard_b64encode(p.read_bytes()).decode()}
              for p in images]
    blocks.append({"kind": "text", "text": "\n".join(parts)})
    return system, blocks, omissions


# ------------------------------------------------------------------- judges

def anthropic_request(judge: dict, system: str, blocks: list[dict], schema: dict) -> dict:
    content = []
    for b in blocks:
        if b["kind"] == "image":
            content.append({"type": "image", "source": {"type": "base64", "media_type": "image/png", "data": b["b64"]}})
        else:
            content.append({"type": "text", "text": b["text"]})
    # No temperature: Claude Opus 5.5 rejects sampling parameters, so effort is the fixed control.
    # No refusal fallbacks: a fallback would silently swap in a different judge model.
    return {"model": judge["model"], "max_tokens": 32000, "system": system,
            "messages": [{"role": "user", "content": content}],
            "output_config": {"effort": judge.get("effort", "high"),
                              "format": {"type": "json_schema", "schema": schema}}}


def openai_request(judge: dict, system: str, blocks: list[dict], schema: dict) -> dict:
    content = []
    for b in blocks:
        if b["kind"] == "image":
            content.append({"type": "image_url", "image_url": {"url": f"data:image/png;base64,{b['b64']}"}})
        else:
            content.append({"type": "text", "text": b["text"]})
    req = {"model": judge["model"],
           "messages": [{"role": "system", "content": system}, {"role": "user", "content": content}],
           "response_format": {"type": "json_schema",
                               "json_schema": {"name": "judgement", "schema": schema, "strict": True}}}
    if judge.get("effort"):
        req["reasoning_effort"] = judge["effort"]
    return req


def call_judge(judge: dict, request: dict) -> tuple[str, dict]:
    key = os.environ.get(judge["key_env"])
    if not key:
        raise RuntimeError(f"{judge['key_env']} is not set")
    if judge["api"] == "anthropic":
        import anthropic

        client = anthropic.Anthropic(api_key=key, max_retries=4, timeout=1800)
        with client.messages.stream(**request) as stream:
            msg = stream.get_final_message()
        if msg.stop_reason == "refusal":
            raise RuntimeError(f"refusal: {msg.stop_details}")
        if msg.stop_reason == "max_tokens":
            raise RuntimeError("judge hit max_tokens")
        text = next(b.text for b in msg.content if b.type == "text")
        return text, {"request_id": msg._request_id, "usage": msg.usage.to_dict()}
    import openai

    client = openai.OpenAI(api_key=key, base_url=judge.get("base_url"), max_retries=4, timeout=1800)
    resp = client.chat.completions.create(**request)
    choice = resp.choices[0]
    if choice.finish_reason not in ("stop", None):
        raise RuntimeError(f"finish_reason={choice.finish_reason}")
    return choice.message.content, {"id": resp.id, "usage": resp.usage.model_dump() if resp.usage else None}


# ------------------------------------------------------------- aggregation

def evidence_caps(gates: dict) -> dict[str, tuple[int, str]]:
    """RUBRIC.md mechanical caps, derived from the evidence pack alone."""
    caps: dict[str, tuple[int, str]] = {}

    def cap(c: str, value: int, why: str) -> None:
        if c not in caps or value < caps[c][0]:
            caps[c] = (value, why)

    if not gates.get("pcb_present"):
        cap("B", 0, "no board.kicad_pcb")
        cap("D", 1, "no board.kicad_pcb")
        cap("E", 1, "no board.kicad_pcb")
    if (gates.get("erc_errors") or 0) > 0 or not gates.get("schematic_present"):
        cap("A", 3, "ERC errors > 0 or no schematic")
    if (gates.get("drc_errors") or 0) > 0:
        cap("B", 2, "DRC errors > 0 (grader fab rules)")
    if (gates.get("unconnected_items") or 0) > 0:
        cap("B", 2, "unrouted connections > 0")
    if gates.get("pcb_present") and not gates.get("lvs_matches"):
        cap("B", 1, "copper vs schematic mismatches > 0")
    return caps


def requirement_c(out: dict, musts: dict[str, bool]) -> float:
    """Criterion C from verdicts: 4 minus 1 per unmet must (partial = 0.5), floored at 0."""
    penalty = sum(1.0 - VERDICT_VALUE[r["verdict"]] for r in out["requirements"] if musts.get(r["id"], True))
    return max(0.0, 4.0 - penalty)


def aggregate(judgements: dict[str, dict], gates: dict, musts: dict[str, bool]) -> dict:
    caps = evidence_caps(gates)
    per_judge: dict[str, dict[str, float]] = {}
    clamps = []
    for vendor, out in judgements.items():
        scores = {c: float(out["criteria"][c]["score"]) for c in CRITERIA}
        scores["C"] = requirement_c(out, musts)
        if out.get("false_claims"):
            if scores["F"] > 0:
                clamps.append({"judge": vendor, "criterion": "F", "from": scores["F"], "to": 0,
                               "why": "judge reported a false claim in DECISIONS.md"})
            scores["F"] = 0.0
        for c, (limit, why) in caps.items():
            if scores[c] > limit:
                clamps.append({"judge": vendor, "criterion": c, "from": scores[c], "to": limit, "why": why})
                scores[c] = float(limit)
        per_judge[vendor] = scores

    medians = {c: statistics.median(s[c] for s in per_judge.values()) for c in CRITERIA}
    spreads = {c: max(s[c] for s in per_judge.values()) - min(s[c] for s in per_judge.values()) for c in CRITERIA}
    total = sum(WEIGHTS[c] * medians[c] / 4 for c in CRITERIA)
    req_ids = sorted({r["id"] for out in judgements.values() for r in out["requirements"]},
                     key=lambda s: int(re.sub(r"\D", "", s) or 0))
    consensus = {}
    for rid in req_ids:
        values = [VERDICT_VALUE[r["verdict"]] for out in judgements.values()
                  for r in out["requirements"] if r["id"] == rid]
        consensus[rid] = {1.0: "met", 0.5: "partial", 0.0: "unmet"}.get(statistics.median(values), "partial")
    return {
        "per_judge": per_judge,
        "evidence_caps": {c: {"max": v, "why": w} for c, (v, w) in caps.items()},
        "clamps": clamps,
        "median": medians,
        "spread": spreads,
        "total": round(total, 1),
        "requirements_consensus": consensus,
        "needs_human_review": sorted(c for c, s in spreads.items() if s >= 2),
    }


# --------------------------------------------------------------------- main

def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("bundle", type=Path, help="judging/out/<run-id> from judging/package")
    ap.add_argument("--panel", type=Path, default=HERE / "panel.toml")
    ap.add_argument("--responses", type=Path, help="directory of <vendor>.json judgements "
                    "(default: judging/responses/<run-id>/)")
    ap.add_argument("--api", action="store_true", help="call the judges through their APIs instead")
    ap.add_argument("--dry-run", action="store_true", help="with --api: write each judge's request and stop")
    args = ap.parse_args()
    if args.dry_run and not args.api:
        sys.exit("--dry-run only applies to --api mode")

    bundle = args.bundle.resolve()
    panel = tomllib.loads(args.panel.read_text())
    judges = panel["judge"]
    if len({j["vendor"] for j in judges}) != 3 or len(judges) != 3:
        sys.exit("panel must have exactly three judges from three different vendors")
    summary = load(bundle / "evidence" / "summary.json")
    reqs = tomllib.loads((bundle / "inputs" / "requirements.toml").read_text())["requirement"]
    requirement_ids = [r["id"] for r in reqs]
    musts = {r["id"]: bool(r.get("must", True)) for r in reqs}
    schema = judgement.output_schema(requirement_ids)

    judgements, meta, failures = {}, {}, {}
    for judge in judges:
        vendor = judge["vendor"]
        if not args.api:
            responses = args.responses or REPO / "judging" / "responses" / bundle.name
            path = responses / f"{vendor}.json"
            if not path.is_file():
                failures[vendor] = f"missing {path}"
                continue
            text = path.read_text()
            info = {"source": str(path), "mode": "native-harness"}
            meta_path = responses / f"{vendor}.meta.json"
            if meta_path.is_file():
                m = json.loads(meta_path.read_text())
                info.update({k: m.get(k) for k in ("harness", "elapsed_minutes", "over_deadline",
                                                    "continue_prompts_sent", "prompt_sha256")})
                if m.get("model") != judge["model"]:
                    failures[vendor] = f"judgement came from {m.get('model')}, panel pins {judge['model']}"
                    continue
        else:
            system, blocks, omissions = build_prompt(bundle, judge.get("images", True))
            build = anthropic_request if judge["api"] == "anthropic" else openai_request
            request = build(judge, system, blocks, schema)
            if args.dry_run:
                out_dir = bundle.parent / f"{bundle.name}.requests"
                out_dir.mkdir(exist_ok=True)
                (out_dir / f"{vendor}.json").write_text(json.dumps(request, indent=1))
                n_img = sum(1 for b in blocks if b["kind"] == "image")
                chars = sum(len(b.get("text", "")) for b in blocks) + len(system)
                print(f"{vendor}: {judge['model']}  ~{chars // 4} text tokens, {n_img} images, "
                      f"omissions={omissions} -> {out_dir / (vendor + '.json')}")
                continue
            try:
                text, info = call_judge(judge, request)
            except Exception as exc:  # recorded, never silently dropped
                failures[vendor] = f"{type(exc).__name__}: {exc}"
                continue
        try:
            out = json.loads(text)
        except ValueError as exc:
            failures[vendor] = f"unparseable judge output: {exc}"
            continue
        problems = judgement.validate(out, requirement_ids)
        if problems:
            failures[vendor] = "; ".join(problems)
            continue
        judgements[vendor] = out
        meta[vendor] = {"model": judge["model"], **info}

    if args.dry_run:
        return 0
    if len(judgements) < 3:
        print(json.dumps({"failures": failures}, indent=2))
        sys.exit("scoring needs all three judges; re-run the failed judge(s)")

    result = {
        "judging_version": JUDGING_VERSION,
        "panel_version": panel["version"],
        "run_id": bundle.name,
        "manufacturable": summary.get("manufacturable"),
        "judges": meta,
        "raw": judgements,
        **aggregate(judgements, summary.get("gates", {}), musts),
    }
    out_path = bundle.parent / f"{bundle.name}.scores.json"
    out_path.write_text(json.dumps(result, indent=2) + "\n")
    print(f"scores: {out_path}")
    print(json.dumps({k: result[k] for k in ("total", "median", "manufacturable", "needs_human_review")}, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
