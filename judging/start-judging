#!/usr/bin/env python3
"""Create an isolated, blinded workspace for one judge (JUDGING.md, native-harness mode).

    judging/start-judging judging/out/<run-id> --judge anthropic [--minutes 30]

The workspace is built from the evidence-packed submission and holds only the
blinded bundle: inputs/, deliverable/ (scrubbed), evidence/, renders/, plus
RUBRIC.md, the judgement schema, ./check-judgement and JUDGE_PROMPT.md. It never
contains run.json, the transcript, the tools supplement or other submissions.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import shutil
import sys
import tomllib
from datetime import datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
sys.path.insert(0, str(HERE))
import judgement  # noqa: E402

BUNDLE_DIRS = ("inputs", "deliverable", "evidence", "renders")


def strip_comment(text: str) -> str:
    return re.sub(r"<!--.*?-->\s*", "", text, count=1, flags=re.S)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("bundle", type=Path, help="judging/out/<run-id> produced by judging/package")
    ap.add_argument("--judge", required=True, help="vendor name from judging/panel.toml")
    ap.add_argument("--minutes", type=int, default=30)
    ap.add_argument("--runs-dir", type=Path, default=Path.home() / "pcba-bench-judging")
    args = ap.parse_args()

    bundle = args.bundle.resolve()
    panel = tomllib.loads((HERE / "panel.toml").read_text())
    judge = next((j for j in panel["judge"] if j["vendor"] == args.judge), None)
    if judge is None:
        sys.exit(f"no judge {args.judge!r} in panel.toml")
    for d in BUNDLE_DIRS[:3]:
        if not (bundle / d).is_dir():
            sys.exit(f"{bundle} is not an evidence bundle (missing {d}/); run judging/package first")
    runs_dir = args.runs_dir.expanduser().resolve()
    if runs_dir.is_relative_to(REPO):
        sys.exit("--runs-dir must be outside the pcba-bench checkout (blinding)")

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    ws_id = f"{bundle.name}--judge-{args.judge}--{stamp}"
    ws = runs_dir / ws_id
    ws.mkdir(parents=True)
    for d in BUNDLE_DIRS:
        if (bundle / d).is_dir():
            shutil.copytree(bundle / d, ws / d)
    shutil.copy2(REPO / "RUBRIC.md", ws / "RUBRIC.md")
    ids = judgement.requirement_ids(ws / "inputs" / "requirements.toml")
    (ws / "judgement.schema.json").write_text(json.dumps(judgement.output_schema(ids), indent=2) + "\n")
    shutil.copy2(HERE / "judgement.py", ws / "check-judgement")
    (ws / "check-judgement").chmod(0o755)

    prompt = strip_comment((REPO / "prompts" / "judge.md").read_text()).replace("{MINUTES}", str(args.minutes))
    (ws / "JUDGE_PROMPT.md").write_text(prompt)

    meta = {
        "schema": 1,
        "workspace_id": ws_id,
        "run_id": bundle.name,
        "vendor": judge["vendor"],
        "model": judge["model"],
        "harness": judge.get("harness"),
        "judging_version": panel["version"],
        "minutes": args.minutes,
        "prompt_sha256": hashlib.sha256(prompt.encode()).hexdigest(),
        "started_at": None,
        "finished_at": None,
    }
    # Kept outside the workspace so the judge can't read it.
    meta_dir = runs_dir / ".meta"
    meta_dir.mkdir(exist_ok=True)
    (meta_dir / f"{ws_id}.json").write_text(json.dumps(meta, indent=2) + "\n")

    print(f"workspace: {ws}")
    print(f"harness:   {judge.get('harness')} with model {judge['model']}")
    print(f"prompt:    {ws / 'JUDGE_PROMPT.md'} (send verbatim as the first message)")
    print(f"then:      judging/finish-judging {ws_id} --mark-start")
    return 0


if __name__ == "__main__":
    sys.exit(main())
