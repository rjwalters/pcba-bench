#!/usr/bin/env python3
"""Render results/RESULTS.md from results/rows/*.json (one row per scored run).

Each result PR adds its own row file, so concurrent PRs don't conflict on rows.
RESULTS.md is fully regenerated from them: if two PRs conflict on RESULTS.md,
re-run this script on the merged rows and commit the output.
"""

from __future__ import annotations

import json
import statistics
from collections import defaultdict
from pathlib import Path

HERE = Path(__file__).resolve().parent
BOARDS = sorted(p.name for p in (HERE.parent / "boards").iterdir() if (p / "board.toml").is_file())


def cell(scores: list[float], mfr: bool, attempted: bool) -> str:
    if not attempted:
        return "–"
    return f"{statistics.mean(scores):.0f}{'✓' if mfr else ''}"


def main() -> int:
    rows = [json.loads(p.read_text()) for p in sorted((HERE / "rows").glob("*.json"))]
    head = " | ".join(b[:2] for b in BOARDS)
    sep = "---|" * len(BOARDS)
    lines = [
        "# Results",
        "",
        "Generated by `results/render` from `results/rows/`. Don't edit by hand.",
        "",
        "Each run is one session with a fixed total time across all ten boards (PROTOCOL.md). "
        "**Suite** = mean over all ten boards of the median-of-three-judges rubric score (0–100); "
        "unattempted boards score 0. **Mfr** = boards passing the Manufacturable flag "
        "(0 ERC/DRC errors, fully routed, copper matches schematic, BOM resolved, fab outputs). "
        "Board cells: score, ✓ = Manufacturable, – = not attempted. ⚑ = judges disagreed by ≥ 2 "
        "on some criterion (human review).",
        "",
    ]
    if not rows:
        lines += ["_No scored runs yet._", ""]
    else:
        groups: dict[tuple, list[dict]] = defaultdict(list)
        for r in rows:
            groups[(r.get("agent"), r.get("track"), r.get("minutes"))].append(r)
        board_lines = []
        for (agent, track, minutes), rs in groups.items():
            cells = []
            for b in BOARDS:
                att = [r["boards"][b] for r in rs if r["boards"].get(b, {}).get("attempted")]
                cells.append(cell([x["score"] for x in att], any(x["manufacturable"] for x in att), bool(att))
                             if att else "–")
            suite = statistics.mean(r["suite_score"] for r in rs)
            mfr = statistics.mean(r["manufacturable_count"] for r in rs)
            board_lines.append((suite, f"| {agent} | {track} | {minutes} | {len(rs)} | **{suite:.1f}** | "
                                       f"{mfr:g} | " + " | ".join(cells) + " |"))
        lines += ["## Leaderboard", "",
                  "Grouped by agent, toolkit and time allotment; repeated runs are averaged.", "",
                  f"| Agent | Toolkit | Min | Runs | Suite | Mfr | {head} |",
                  f"|---|---|---|---|---|---|{sep}"]
        lines += [x[1] for x in sorted(board_lines, key=lambda x: -x[0])]
        lines += ["", "## All runs", "",
                  f"| Judged | Agent | Toolkit | Min | Suite | Mfr | {head} | Run |",
                  f"|---|---|---|---|---|---|{sep}---|"]
        for r in sorted(rows, key=lambda r: (r["judged_at"], r["run_id"]), reverse=True):
            cells = [cell([r["boards"][b]["score"]], r["boards"][b]["manufacturable"], r["boards"][b]["attempted"])
                     if b in r["boards"] else "–" for b in BOARDS]
            flag = " ⚑" if r.get("needs_human_review") else ""
            lines.append(f"| {r['judged_at']} | {r.get('agent')} | {r.get('track')} | {r.get('minutes')} | "
                         f"{r['suite_score']}{flag} | {r['manufacturable_count']} | " + " | ".join(cells)
                         + f" | `{r['run_id']}` |")
        lines.append("")
    (HERE / "RESULTS.md").write_text("\n".join(lines))
    print(f"rendered {len(rows)} row(s) -> {HERE / 'RESULTS.md'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
